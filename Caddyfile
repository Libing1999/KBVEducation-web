# KBV Education — Caddy reverse-proxy + SPA config
#
# Serves the React/Vite static build and proxies /api/* to the backend
# container, mirroring the /api proxy vite.config.ts uses in local dev.
#
# HTTPS is REQUIRED for the reflection voice recorder: browsers only expose
# navigator.mediaDevices (getUserMedia) in a secure context, and a bare
# http:// origin is not one — localhost is the only exemption, which is why
# recording works in dev but not on an http:// deployment.
#
# Set SITE_ADDRESS to the public domain (e.g. "education.kbv.com") and Caddy
# provisions Let's Encrypt certs and redirects http->https automatically.
# The ":80" default keeps plain-HTTP behaviour for local/compose smoke tests.

{$SITE_ADDRESS::80} {
	# Reverse-proxy /api/* to the Spring Boot backend over the
	# internal container network (same role as the old nginx proxy_pass).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Serve the React SPA — unknown paths fall back to index.html
	# so client-side routing (React Router) handles them.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Cache static assets (JS, CSS, fonts, images) for 30 days.
	@static path *.css *.js *.svg *.woff2 *.woff *.ttf *.eot *.ico *.png *.jpg *.jpeg *.gif
	header @static Cache-Control "public, max-age=2592000, immutable"
}
